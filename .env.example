# DocuConvert uses two environment files:
#
#   1. backend/.env          <- copy from backend/.env.example
#   2. frontend/.env.local   <- copy from frontend/.env.local.example
#
# This root file is only a reference and is not read by the application.

# ---------------------------------------------------------------------------
# backend/.env
# ---------------------------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=sqlite:///./docuconvert.db
STORAGE_DIR=../storage
MAX_UPLOAD_MB=25
MAX_FILES_PER_JOB=10
RESULT_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=15
CONVERSION_TIMEOUT_SECONDS=180
ALLOW_ANONYMOUS=true
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LIBREOFFICE_PATH=
TESSERACT_CMD=

# ---------------------------------------------------------------------------
# frontend/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
