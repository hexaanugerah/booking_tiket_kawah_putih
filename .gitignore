# Environment files (never commit secrets)
.env
.env.*
!**/.env.example
!**/.env.local.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
backend/.venv/
backend/docuconvert.db
backend/.requirements.sha256
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
frontend/public/pdf.worker.min.mjs

# Local storage (documents must never be committed)
storage/**
!storage/.gitkeep

# Logs and editor files
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
